# Samsung Services Center — basic Apache config for cPanel shared hosting

DirectoryIndex index.html index.php

# Serve pretty URLs: /about -> /about.html
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (uncomment once your SSL certificate is active in cPanel)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Drop the .html extension
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Basic hardening
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes

# Keep repo/dev files out of the web root if they ever get copied there
<FilesMatch "^(\.git|\.gitignore|\.cpanel\.yml|CLAUDE\.md|README\.md)">
  Require all denied
</FilesMatch>
